# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# FIREBASE CLOUD-ONLY — SEPARACIÓN DE ENTORNOS (DEVELOPMENT vs PRODUCTION)
# ==============================================================================
# Nunca almacenes llaves privadas, credenciales Admin SDK ni tokens secretos
# en variables con prefijo VITE_ (se exponen en el bundle del navegador).
#
# 1. DESARROLLO LOCAL (.env.local):
#    Configura un proyecto Firebase independiente para desarrollo/pruebas usando
#    variables VITE_FIREBASE_DEV_*.
#    Si VITE_FIREBASE_REQUIRE_DEV_ENV="true", el modo dev fallará explícitamente
#    si faltan estas variables, evitando usar el proyecto de producción.
#
# VITE_FIREBASE_REQUIRE_DEV_ENV="false"
# VITE_FIREBASE_DEV_API_KEY=""
# VITE_FIREBASE_DEV_AUTH_DOMAIN=""
# VITE_FIREBASE_DEV_PROJECT_ID=""
# VITE_FIREBASE_DEV_STORAGE_BUCKET=""
# VITE_FIREBASE_DEV_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_DEV_APP_ID=""
# VITE_FIREBASE_DEV_FIRESTORE_DATABASE_ID=""
#
# 2. PRODUCCIÓN (CI / Hosting / Build `vite build`):
#    Define variables VITE_FIREBASE_PROD_* (o usa firebase-applet-config.json
#    exclusivamente para producción). El sistema bloquea automáticamente un build
#    de producción si su projectId coincide con VITE_FIREBASE_DEV_PROJECT_ID.
#
# VITE_FIREBASE_PROD_API_KEY=""
# VITE_FIREBASE_PROD_AUTH_DOMAIN=""
# VITE_FIREBASE_PROD_PROJECT_ID=""
# VITE_FIREBASE_PROD_STORAGE_BUCKET=""
# VITE_FIREBASE_PROD_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_PROD_APP_ID=""
# VITE_FIREBASE_PROD_FIRESTORE_DATABASE_ID=""
#
# 3. STORAGE BROKER BACKEND (SERVER-ONLY — NUNCA USAR PREFIJO VITE_ EN CREDENCIALES):
#    En Cloud Run con Service Account IAM basta con ADC (sin JSON estático).
#    En servidor local define GOOGLE_APPLICATION_CREDENTIALS o FIREBASE_SERVICE_ACCOUNT_JSON.
#
# PORT="3000"
# FIREBASE_PROJECT_ID="gen-lang-client-0383225470"
# FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-yorcatalog-2bed9ea5-0c3f-4ed5-ba39-992a8dc979d8"
# FIREBASE_STORAGE_BUCKET="gen-lang-client-0383225470.firebasestorage.app"
# GOOGLE_APPLICATION_CREDENTIALS="/ruta/segura/service-account.json"
# FIREBASE_SERVICE_ACCOUNT_JSON=""
#
# Opcional en cliente si el Broker corre en un origen distinto al frontend:
# VITE_STORAGE_BROKER_BASE_URL=""

